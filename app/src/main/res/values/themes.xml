<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SendspinSatellite" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.SendspinSatellite.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sendspin_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/sendspin_satellite_icon_v1</item>
        <item name="postSplashScreenTheme">@style/Theme.SendspinSatellite</item>
    </style>
</resources>
