<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SendspinSatellite" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/indigo_velvet</item>
        <item name="colorPrimaryVariant">@color/midnight_violet</item>
        <item name="colorOnPrimary">@color/honeydew</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/steel_blue</item>
        <item name="colorSecondaryVariant">@color/frozen_water</item>
        <item name="colorOnSecondary">@color/midnight_violet</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.SendspinSatellite.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sandpiper_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/sandpiper_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.SendspinSatellite</item>
    </style>
</resources>
